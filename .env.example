# Server-side only. Never expose this as VITE_GROQ_API_KEY.
GROQ_API_KEY=gsk_your_server_side_key

# Optional. Defaults to openai/gpt-oss-120b in api/assistant.js.
GROQ_MODEL=openai/gpt-oss-120b

# Public browser-safe Supabase connection values.
# Get these from the Supabase project Connect panel.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Canonical production URL used by the LTI registration descriptor.
PUBLIC_APP_URL=https://your-simumath-domain.example
